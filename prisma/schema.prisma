// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ==============================================
// ENUMS
// ==============================================

enum pedido_estado {
  pendiente
  confirmado
  preparando
  enviado
  entregado
  cancelado
}

enum pedido_estado_pago {
  pendiente
  pagado
  rechazado
  reembolsado
}

enum usuario_rol {
  cliente
  admin
  vendedor
  almacenero
}

enum usuario_genero {
  MASCULINO
  FEMENINO
  OTRO
  PREFIERO_NO_DECIR
}

enum usuario_documento_tipo {
  DNI
  CE
  PASAPORTE
  RUC
}

// ==============================================
// UBICACIÓN (departamento -> provincia -> distrito)
// ==============================================

model departamento {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(100)
  provincia provincia[]
}

model provincia {
  id             Int          @id @default(autoincrement())
  nombre         String       @db.VarChar(100)
  departamentoId Int
  departamento   departamento @relation(fields: [departamentoId], references: [id])
  distrito       distrito[]
}

model distrito {
  id                  Int                 @id @default(autoincrement())
  nombre              String              @db.VarChar(100)
  provinciaId         Int
  provincia           provincia           @relation(fields: [provinciaId], references: [id])
  direcciones_usuario direccion_usuario[]
  direcciones_pedido  pedido_direccion[]
}

// ==============================================
// DIRECCIONES
// ==============================================
model direccion_usuario {
  id            Int     @id @default(autoincrement())
  usuario_id    Int
  nombres       String
  apellidos     String
  telefono      String
  direccion     String
  distrito_id   Int
  instrucciones String?

  es_principal Boolean? @default(false)

  usuario  usuario  @relation(fields: [usuario_id], references: [id])
  distrito distrito @relation(fields: [distrito_id], references: [id])
}

model pedido_direccion {
  id            Int     @id @default(autoincrement())
  pedido_id     Int     @unique
  nombres       String
  apellidos     String
  telefono      String
  direccion     String
  distrito_id   Int
  instrucciones String?

  pedido   pedido   @relation(fields: [pedido_id], references: [id])
  distrito distrito @relation(fields: [distrito_id], references: [id])
}

